# Beacon Check-In API — production runtime environment
#
# Copy to `.env` on the VM (or let the deploy workflow write it).
# NEVER commit the real `.env`.

# Images published by GitHub Actions
GHCR_IMAGE=ghcr.io/smartoryu/beacon-check-in-api:latest
GHCR_CADDY_IMAGE=ghcr.io/smartoryu/beacon-check-in-caddy:latest
GHCR_WEB_IMAGE=ghcr.io/smartoryu/beacon-check-in-web:latest

# Public endpoints
DOMAIN=beacon-check-in-api.playground.my.id
WEB_DOMAIN=admin-beacon-check-in.playground.my.id
ACME_EMAIL=you@example.com

# Caddy DNS-01 challenge (Cloudflare token needs Zone:Read + Zone.DNS:Edit)
CLOUDFLARE_API_TOKEN=replace-me

# App
APP_MODE=production
APP_BASE_URL=https://beacon-check-in-api.playground.my.id
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://admin-beacon-check-in.playground.my.id,http://localhost:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=300
ENABLE_API_DOCS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_BURST_SIZE=60

# Supabase Postgres (session pooler recommended)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
PG_MAX_POOL_SIZE=10
PG_MAX_RETRIES=5

# Offline check-in guards
MAX_OFFLINE_AGE=24h
MAX_CLOCK_SKEW=5m

# Mailer is optional for this POC. The API continues without it if unreachable.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_SENDER_NAME="Beacon Check-In"
SMTP_SENDER_EMAIL="noreply@playground.my.id"

# First-admin bootstrap (used by `bootstrap:admin`, not by the API server)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@playground.my.id
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Unused optional services
PUBLIC_ASSETS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=
S3_FORCE_PATH_STYLE=false
S3_USE_SSL=false

# Logging / telemetry
LOG_FORMAT=json
LOG_LEVEL=info
LOG_NO_COLOR=true
OTEL_ENABLE_TELEMETRY=false
OTEL_SERVICE_NAME=beacon-check-in-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_INSECURE_MODE=false
OTEL_TRACING_SAMPLE_RATE=0
